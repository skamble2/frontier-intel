# Copy to .env and fill in what you need:  cp .env.example .env
#
# Nothing here is required to explore the committed database. The deterministic
# pipeline, the check battery, the web UI and every figure run with this file
# empty. Each key below unlocks one specific capability.

# --- models ---------------------------------------------------------------
# Required for any stage that calls a model: classify, extract, repair, judge,
# persona, channel, verify, faithfulness. Without it those stages skip and the
# rest of the pipeline still runs and still passes.
ANTHROPIC_API_KEY=

# Optional second model family. Used only when a task is routed to an OpenAI
# model. Dawid-Skene reliability needs two conditionally independent labelers,
# so this is what makes the judge-reliability figure meaningful; it also serves
# as the fallback path if one provider is unavailable.
OPENAI_API_KEY=

# --- sources --------------------------------------------------------------
# Optional. Raises the GitHub API budget from 60/hr (unauthenticated) to
# 5,000/hr. Without it the register still resolves GitHub identities, just
# fewer per run — the code caps itself to stay under the anonymous limit.
GITHUB_TOKEN=

# Optional. The X/social source is the only PAID source. Leave blank to skip it
# entirely; every other source is free. Always `--dry-run` first for a cost
# estimate.
X_BEARER_TOKEN=

# --- delivery -------------------------------------------------------------
# Optional. Only needed for `alerts --sink slack`. The default sink is stdout,
# which needs nothing.
SLACK_WEBHOOK_URL=

# --- observability (optional) ---------------------------------------------
# Set FLI_TRACING=1 to emit OpenInference spans to Phoenix. Off by default, and
# a no-op if the OpenTelemetry client is not installed
# (pip install -r requirements-tracing.txt).
FLI_TRACING=
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006

# Optional. reasoning.effort for OpenAI reasoning models; blank uses their
# default.
FLI_REASONING_EFFORT=
