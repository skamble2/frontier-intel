# --- secrets -------------------------------------------------------------
# NEVER commit: the Anthropic API key lives here.
.env
.env.*
!.env.example

# --- environments --------------------------------------------------------
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/

# --- data ----------------------------------------------------------------
# The database is a build artifact of the pipeline, not source: it is rebuilt
# by `python3 -m fli.cli pipeline` and it is large (15 MB and growing).
# Snapshots are evidence for the write-up but are 14-35 MB each; the claims
# they support are exported as text under docs/, so the binaries stay out.
# To include one deliberately: git add -f data/snapshots/<name>.db
data/*.db
data/*.db-journal
data/*.db.bak-*
data/snapshots/*.db

# --- third-party source material -----------------------------------------
# BIT Capital's own published factsheet and quarterly report. Used as input to
# research/facts.md; no reason to redistribute them.
research/raw/

# --- generated output ----------------------------------------------------
# Regenerated by one command each, so they are build artifacts rather than
# source. The DESIGN docs (specs, rubric, hypotheses, ERD/HLD) are source and
# ARE committed — they are the architecture write-up.
docs/metrics-out.txt          # sqlite3 data/fli.db < docs/metrics.sql
docs/figures/                 # python3 -m fli.cli evaluate
docs/evaluation-report.md     # python3 -m fli.cli evaluate
pipeline.log

# --- OS / editor ---------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
