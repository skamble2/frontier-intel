# --- secrets -------------------------------------------------------------
# NEVER commit: the Anthropic API key lives here.
.env
.env.*

# --- environments --------------------------------------------------------
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/

# --- data ----------------------------------------------------------------
# data/fli.db IS committed: the database with real data ships with the code, so
# a clone reproduces the reported numbers without re-running the pipeline. It is
# the ONLY database here — working snapshots and pre-change .bak copies are
# local scratch and are deleted once whatever they evidenced has been exported
# as text (see docs/ingestion-robustness-evidence.txt). The rules below stay so
# that scratch can never be committed by accident.
data/*.db
!data/fli.db
data/*.db-journal
# WAL sidecars, transient. The database opens in WAL mode so an inspecting
# reader cannot block a paid run. Before committing data/fli.db, close every
# connection so SQLite checkpoints the WAL back into it — otherwise the
# committed file is missing the most recent writes.
data/*.db-wal
data/*.db-shm
data/*.db.bak-*
data/snapshots/*.db
# FUSE leaves .fuse_hidden* handles for deleted-but-open files when the DB is
# opened over a mounted filesystem; pure junk, never a real artifact.
data/.fuse_hidden*
# Local macOS marker that keeps Spotlight from indexing (and locking) the DB
# mid-run. A machine-specific concern, not part of the product.
data/.metadata_never_index

# --- third-party source material -----------------------------------------
# BIT Capital's own published factsheet and quarterly report. Used as input to
# research/facts.md; no reason to redistribute them.
research/raw/

# --- generated output ----------------------------------------------------
# Figures, the metrics dump and the evaluation report ARE committed, so they
# render on the repository page without anyone having to run anything first.
# Regenerate with:
#   python3 -m fli.cli evaluate
#   sqlite3 data/fli.db < docs/metrics.sql > docs/metrics-out.txt
# NOTE: a .gitignore pattern cannot carry a trailing comment — the whole line
# becomes the pattern, which silently matches nothing.
pipeline.log
# Digests are regenerable build output (python3 -m fli.cli digest). Dated
# sample sets are committed as evidence the delivery layer works, force-added
# past this rule:  git add -f docs/digests/2026-08-01-*
docs/digests/*

# --- OS / editor ---------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
# Local AI tooling config, not part of the product
.claude/
CLAUDE.md

# Working notes, not deliverables. The docs/ working notes (day-5 scoring spec,
# evaluation plan, report notes, X source hypotheses, refactor spec, expansion
# run) were deleted once their durable content was folded into the shipped
# write-ups, so there is nothing left here to ignore under docs/.
research/one-pager.md
scripts/
